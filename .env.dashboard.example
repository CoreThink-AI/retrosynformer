# Copy to .env.dashboard and fill in real values.
# Never commit .env.dashboard — it contains credentials.

# Flask session signing key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# Dashboard login credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Optional: point at a non-default results directory
# RESULTS_ROOT=/home/hobs/code/corethink/retrosynformer/results/

# Optional: Cloud Run inference service URL for health panel
# CLOUD_RUN_URL=https://retrosynformer-inference-xxx.run.app
